    "EditTransaction": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "enum": [
            "ui",
            "agent"
          ],
          "title": "Actor",
          "type": "string"
        },
        "base_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Base Hash",
          "type": "string"
        },
        "base_snapshot": {
          "format": "uuid",
          "title": "Base Snapshot",
          "type": "string"
        },
        "confirmed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confirmed At"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "operations": {
          "items": {
            "discriminator": {
              "mapping": {
                "replace_joint": "#/$defs/ReplaceJoint",
                "replace_link": "#/$defs/ReplaceLink"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ReplaceLink"
              },
              {
                "$ref": "#/$defs/ReplaceJoint"
              }
            ]
          },
          "minItems": 1,
          "title": "Operations",
          "type": "array"
        },
        "preview_snapshot": {
          "$ref": "#/$defs/RobotSnapshot"
        },
        "validation": {
          "const": "valid",
          "title": "Validation",
          "type": "string"
        }
      },
      "required": [
        "id",
        "base_snapshot",
        "base_hash",
        "operations",
        "preview_snapshot",
        "validation",
        "actor",
        "confirmed_at"
      ],
      "title": "EditTransaction",
      "type": "object"
    },
