          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Url"
        }
      },
      "required": [
        "id",
        "sha256",
        "relative_path",
        "mime",
        "size",
        "source_url",
        "source_commit",
        "license_id"
