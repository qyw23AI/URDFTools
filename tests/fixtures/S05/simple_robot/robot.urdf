<?xml version="1.0" encoding="UTF-8"?>
<robot name="ViewerAnalysisFixture">
  <material name="yellow"><color rgba="0.9 0.8 0.2 1"/></material>
  <link name="body">
    <inertial>
      <origin xyz="0.01 0 0" rpy="0 0 0"/>
      <mass value="1.25"/>
      <inertia ixx="0.010" ixy="0" ixz="0" iyy="0.020" iyz="0" izz="0.030"/>
    </inertial>
    <visual name="body_visual">
      <geometry><box size="0.3 0.2 0.08"/></geometry>
      <material name="yellow"/>
    </visual>
    <collision name="body_collision">
      <geometry><box size="0.34 0.24 0.12"/></geometry>
    </collision>
  </link>
  <link name="arm">
    <!-- Intentionally no inertial block: UI must report unknown, not loader's zero defaults. -->
    <visual name="arm_visual">
      <origin xyz="0.25 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://viewer_robot/meshes/arm.obj"/></geometry>
      <material name="yellow"/>
    </visual>
  </link>
  <joint name="shoulder" type="revolute">
    <parent link="body"/><child link="arm"/>
    <origin xyz="0.15 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.20" upper="1.20" effort="15" velocity="2"/>
  </joint>
</robot>
